{
  "version": "1.3",
  "meta": { "featureId": "ORDERS-2", "specReference": "specs/orders.md#order-number", "title": "The new order number is shown in the list" },
  "targets": ["cdp-chromium"],
  "steps": [
    { "type": "navigate", "url": "/orders/new" },
    { "type": "click", "locator": { "by": "role", "role": "button", "name": "Place order" } },
    { "type": "remember", "name": "orderNumber", "from": { "element": { "by": "testId", "testId": "order-number" }, "read": "text" } },
    { "type": "navigate", "url": "/orders" },
    { "type": "fill", "locator": { "by": "role", "role": "searchbox", "name": "Search orders" }, "value": { "valueName": "orderNumber" } },
    { "type": "expect", "locator": { "by": "role", "role": "row", "name": { "valueName": "orderNumber" } }, "assert": { "kind": "visible" }, "criterionId": "orders.number-listed" }
  ]
}
