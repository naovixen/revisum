// The coding agent runs in here. It must have no Git or GitHub credentials:
// check that `gh auth status` and `git push --dry-run` both fail inside the container.
{
  "name": "revisum",
  // Pin by digest at M0 (docker pull, then docker inspect --format '{{index .RepoDigests 0}}').
  // CI uses the same digest, so local and CI runs match.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm@sha256:<pin-at-M0>",
  "containerEnv": {
    "MOZ_HEADLESS": "1",
    "GIT_TERMINAL_PROMPT": "0"
  },
  // Read-only access to the research repo. The spikes are only for seeding (session 0); remove that mount after M0.
  // The decision docs stay mounted so the doc numbers cited in specs (`04`, `09`, ...) resolve.
  "mounts": [
    "source=E:/core/docs/research/spikes,target=/research-spikes,type=bind,readonly",
    "source=E:/core/docs,target=/research-docs,type=bind,readonly"
  ],
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && git config --global --unset-all credential.helper || true",
  "customizations": {
    "vscode": {
      "settings": {
        "dev.containers.copyGitConfig": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none"
      }
    }
  }
}
