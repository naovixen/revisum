// The pinned Linux image that CI runs. Locally it runs `npm run check:linux`, so a check can be
// repeated on exactly CI's Linux, Node and fonts. Claude works on Windows, not in here
// (see docs/decisions/single-session-workflow.md). It holds no Git or GitHub credentials.
{
  "name": "revisum",
  // Pin by digest at M0 (docker pull, then docker inspect --format '{{index .RepoDigests 0}}').
  // CI uses the same digest, so local and CI runs match.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm@sha256:970eebf5b82d3800bdd9f46680e1c4c664d365d18603148540788356700ce301",
  // Chrome's sandbox needs user namespaces, which Docker's default seccomp profile allows only with
  // full admin rights. This profile is Docker's default plus those namespace calls, so browsers
  // keep their sandbox. Chrome refuses to sandbox as root; checks run as the image's "node" user.
  "runArgs": ["--security-opt", "seccomp=${localWorkspaceFolder}/.devcontainer/seccomp-chrome-sandbox.json"],
  "containerEnv": {
    "MOZ_HEADLESS": "1",
    "GIT_TERMINAL_PROMPT": "0"
  },
  // Linux needs its own node_modules: some packages, TypeScript among them, install a different
  // binary per operating system. A volume keeps it apart from the Windows install, and is faster.
  "mounts": [
    "source=revisum-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  // The volume starts owned by root. The browsers need system libraries, as in CI. The repo folder
  // is owned by the Windows user, so git needs safe.directory to read it; that grants no push access.
  "postCreateCommand": "sudo chown node node_modules && npm ci && sudo node node_modules/playwright-core/cli.js install-deps chromium firefox webkit && git config --global --add safe.directory ${containerWorkspaceFolder} && (git config --global --unset-all credential.helper || true)",
  "customizations": {
    "vscode": {
      "settings": {
        "dev.containers.copyGitConfig": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none"
      }
    }
  }
}
