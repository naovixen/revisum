{
  "version": "1.3",
  "meta": {
    "featureId": "SIGNUP-1",
    "specReference": "specs/signup.md#happy-path",
    "title": "Determinism controls are applied"
  },
  "targets": [
    "cdp-chromium"
  ],
  "steps": [
    {
      "type": "navigate",
      "url": "/"
    },
    {
      "type": "expect",
      "locator": {
        "by": "testId",
        "testId": "env-lang"
      },
      "assert": {
        "kind": "textEquals",
        "value": "de-DE"
      },
      "criterionId": "environment.locale-pinned"
    },
    {
      "type": "expect",
      "locator": {
        "by": "testId",
        "testId": "env-tz"
      },
      "assert": {
        "kind": "textEquals",
        "value": "Asia/Tokyo"
      },
      "criterionId": "environment.timezone-pinned"
    }
  ]
}
