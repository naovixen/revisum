{
  "version": "1.2",
  "meta": { "featureId": "ORDERS-3", "specReference": "specs/orders.md#backend-state", "title": "A new order is paid in the backend and cleaned up" },
  "targets": ["playwright-chromium"],
  "steps": [
    { "type": "call", "call": "createOrder", "arguments": { "customerName": "Ada Lovelace", "contactEmail": "ada@example.com", "quantity": 2, "region": "eu", "giftWrap": false, "deliveryDay": "2026-11-02" }, "remember": { "orderId": "orderId" } },
    { "type": "navigate", "url": { "segments": ["orders", { "valueName": "orderId" }] } },
    { "type": "click", "locator": { "by": "role", "role": "button", "name": "Confirm order" } },
    { "type": "expectBackend", "call": "getOrder", "arguments": { "orderId": { "valueName": "orderId" } }, "field": "status", "assert": { "kind": "equals", "value": "paid" }, "criterionId": "orders.paid-in-backend" }
  ],
  "cleanup": [
    { "type": "call", "call": "deleteOrder", "arguments": { "orderId": { "valueName": "orderId" } } }
  ]
}
