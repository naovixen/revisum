  "intents": [
    {
      "suite": "example-shop",
      "sample": "original",
      "sourceUrl": "https://github.com/example/shop/blob/main/tests/settings.spec.ts",
      "testName": "saves the settings",
      "verdict": "expressible",
      "reason": "A click and a status check",
      "plan": {
        "version": "1.2",
        "meta": {
          "featureId": "SHOP-1",
          "specReference": "tests/shop-1.spec.ts",
          "title": "Save settings"
        },
        "targets": [
          "playwright-chromium"
        ],
        "steps": [
          {
            "type": "navigate",
            "url": "/"
          },
          {
            "type": "click",
            "locator": {
              "by": "role",
              "role": "button",
              "name": "Save"
            }
          },
          {
            "type": "expect",
            "locator": {
              "by": "role",
              "role": "status",
              "name": "Saved"
            },
            "assert": {
              "kind": "visible"
            },
            "criterionId": "settings.saved"
          }
        ]
      }
    },
    {
      "suite": "example-shop",
      "sample": "original",
      "sourceUrl": "https://github.com/example/shop/blob/main/tests/transactions.spec.ts",
      "testName": "shows the first transaction",
      "verdict": "expressible",
      "reason": "Found by a record-id prefix: a CSS locator",
      "plan": {
        "version": "1.3",
        "meta": {
          "featureId": "SHOP-2",
          "specReference": "tests/shop-2.spec.ts",
