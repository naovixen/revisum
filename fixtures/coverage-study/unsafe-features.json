          },
          {
            "type": "expect",
            "locator": {
              "by": "css",
              "selector": "[data-test^=\"transaction-item-\"]",
              "position": "first"
            },
            "assert": {
              "kind": "visible"
            },
            "criterionId": "transactions.first-shown"
          }
        ]
