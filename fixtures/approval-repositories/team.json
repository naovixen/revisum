{
  "description": "A team project with a code-owners file. Pull request 12 changes the sign-up plan and the sign-up code; dev-ada wrote both. owner-grace owns plans and trusted files, reviewer-linus owns only the docs. The project also declares the agent lock-down, with owner-grace as maintainer.",
  "repository": "example/team-shop",
  "protectedBranch": "main",
  "protectedCommit": "commit-main-head",
  "protectedFiles": {
    "project.json": {
      "origins": [
        "http://127.0.0.1:4173"
      ],
      "limits": {
        "stepTimeoutMilliseconds": 2000
      },
      "matrix": [
        {
          "id": "playwright-chromium",
          "adapter": "playwright",
          "engine": "chromium",
          "device": "desktop-1280",
          "locale": "de-DE",
          "timezone": "Asia/Tokyo",
          "colorScheme": "dark",
          "reducedMotion": "reduce"
        }
      ],
      "secretNames": [
        "SIGNUP_PASSWORD"
      ]
    },
    "approvers.json": {
      "agentLockdown": {
        "maintainer": "owner-grace",
        "agentDenyRulesPath": ".claude/settings.json",
        "deniedActions": [
          "push",
          "merge",
          "approve-pull-request"
        ],
        "agentHasGithubCredentials": false
      }
    },
    ".claude/settings.json": {
      "permissions": {
        "deny": [
          "Bash(git push *)",
          "Bash(git merge *)",
          "Bash(gh pr merge *)",
          "Bash(gh pr review *)",
          "PowerShell(git push *)",
          "PowerShell(git merge *)",
          "PowerShell(gh pr merge *)",
          "PowerShell(gh pr review *)"
        ]
      }
    },
    ".github/CODEOWNERS": "# Trusted files need a code owner's review.\n/plans/ @owner-grace\n/baselines/ @owner-grace\n/project.json @owner-grace\n/approvers.json @owner-grace\n/.github/CODEOWNERS @owner-grace\n/docs/ @reviewer-linus\n"
  },
  "workingCopy": {},
