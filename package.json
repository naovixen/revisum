{
  "name": "revisum-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#test-support/*": "./test/support/*"
  },
  "scripts": {
    "browsers": "node tools/install-browsers.ts",
    "postinstall": "npm ci --prefix tools/eslint --no-audit --no-fund",
    "typecheck": "tsc --build",
    "lint": "node tools/RunRepositoryRules.ts",
    "lint:code": "node tools/eslint/node_modules/eslint/bin/eslint.js --config tools/eslint/eslint.config.js \"packages/**/*.ts\" \"tools/**/*.ts\" \"test/**/*.ts\"",
    "lint:names": "node tools/lint-names.ts --self-test && node tools/lint-names.ts",
    "test": "node tools/run-test-folder.ts --without-browser test/unit test/contract",
    "test:browser": "node tools/run-test-folder.ts --browser-shard 1/1 test/unit test/contract",
    "proofs": "node tools/run-test-folder.ts test/proofs",
    "replay": "node tools/run-test-folder.ts test/replay",
    "goldens:record": "node tools/RecordGoldens.ts",
    "gates": "node tools/project-metrics.ts && node tools/guarantee-map.ts && node tools/run-test-folder.ts --require-results test/unit test/contract test/proofs test/replay",
    "benchmark": "node tools/benchmark.ts",
    "check:tests": "npm run typecheck && npm run lint && npm run lint:code && npm run lint:names && npm test",
    "check": "npm run check:tests",
    "check:push": "npm run check && npm run test:browser && npm run proofs && npm run replay && npm run gates",
    "check:full": "node tools/RunFullCheck.ts",
    "check:containers": "node --test --test-concurrency=1 \"test/containers/*.test.ts\"",
    "check:linux": "npx -y @devcontainers/cli@0.89.0 up --workspace-folder . && npx -y @devcontainers/cli@0.89.0 exec --workspace-folder . bash -c \"npm ci --no-audit --no-fund && npm run browsers && npm run check:push\"",
    "format": "prettier --write \"packages/**/*.ts\" \"tools/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tools/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
